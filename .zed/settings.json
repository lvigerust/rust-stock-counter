// Project settings for Zed. See https://zed.dev/docs/languages/rust
{
  "languages": {
    "Rust": {
      "format_on_save": "on",
      "inlay_hints": {
        "enabled": true
      }
    }
  },
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        // Build into target/rust-analyzer so checks on save don't block
        // `cargo run` on the build directory lock.
        "rust": {
          "analyzerTargetDir": true
        },
        // Show clippy lints on save, not only compiler errors.
        "check": {
          "command": "clippy"
        },
        "inlayHints": {
          "closureReturnTypeHints": {
            "enable": "with_block"
          },
          "lifetimeElisionHints": {
            "enable": "skip_trivial",
            "useParameterNames": true
          }
        }
      }
    }
  }
}
